# Dependensi
node_modules/
.bun-cache/

# Build
dist/
build/
.next/
out/
# Cache inkremental TypeScript — artefak mesin, bukan sumber. Ia berubah pada
# setiap typecheck dan menghasilkan konflik yang tidak berarti apa-apa.
*.tsbuildinfo

# Lingkungan & rahasia
.env
.env.*
!.env.example
*.pem
*.key

# Basis data & penyimpanan lokal
*.sqlite
*.db
/data/
/minio-data/

# Log & sementara
*.log
.tmp/
coverage/
playwright-report/
test-results/
.vitest/

# Hasil eval — berisi keluaran model atas data yang disamarkan
/eval/runs/
/eval/datasets/*.jsonl
!/eval/datasets/.gitkeep

# Berkas hasil ekspor laporan
/exports/

# Perkakas
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — setelan lokal per pengembang
.claude/settings.local.json

# Dev process manager runtime (scripts/dev.sh)
.dev/

# Cache bytecode dari skrip verifikasi di scripts/.
__pycache__/

# Keluaran graphify: graf pengetahuan yang dibangkitkan dari kode.
#
# Bukan sumber, dan sebagian isinya khusus mesin: .graphify_python dan
# .graphify_root menyimpan jalur absolut milik satu komputer, sehingga berkas
# itu salah bagi setiap kloning lain. Ditambah graph.json + graph.html sekitar
# 6MB yang berubah total setiap kali graf dibangun ulang. Jalankan graphify
# lagi untuk memperolehnya kembali.
graphify-out/
