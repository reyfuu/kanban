{
  "name": "@sigap/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, hand-reviewed SQL migrations, and a configured PostgreSQL client for SIGAP.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "seed": "tsx --env-file=../../.env seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
