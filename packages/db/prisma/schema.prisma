/// FR-B-019 state diagram plus the FR-B-020 rule 3 terminal state.
enum RevocationTicketStatus {
  TERBUKA
  DALAM_PROSES
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI_TERTUTUP
  GAGAL_DIVERIFIKASI
  DIKECUALIKAN
  TIDAK_DAPAT_DIVERIFIKASI

  @@map("revocation_ticket_status")
}

/// Shared by SodViolation.status and AccessAnomaly.status.
enum FindingStatus {
  TERBUKA
  DIKECUALIKAN
  TERSELESAIKAN

  @@map("finding_status")
}

/// FR-B-007 detection table.
enum AccessAnomalyCode {
  AN_01 @map("AN-01")
  AN_02 @map("AN-02")
  AN_03 @map("AN-03")
  AN_04 @map("AN-04")
  AN_05 @map("AN-05")
  AN_06 @map("AN-06")
  AN_07 @map("AN-07")
  AN_08 @map("AN-08")

  @@map("access_anomaly_code")
}

// ============================================================================
// Modul A — Evidence Vault enums (docs/04-TRD.md Sec 3.2, docs/03-FRD.md FR-A)
// ============================================================================

/// FR-A-001 · how often a control is performed.
enum ControlFrequency {
  HARIAN
  MINGGUAN
  BULANAN
  TRIWULANAN
  TAHUNAN
  AD_HOC

  @@map("control_frequency")
}

/// FR-A-001 · preventive/detective/corrective.
enum ControlType {
  PREVENTIF
  DETEKTIF
  KOREKTIF

  @@map("control_type")
}

/// FR-A-001 · manual/automated/semi-automated.
enum ControlNature {
  MANUAL
  OTOMATIS
  SEMI_OTOMATIS

  @@map("control_nature")
}

/// FR-A-003 aturan 3 · how completely a control satisfies a framework item.
enum CoverageLevel {
  PENUH
  SEBAGIAN
  MENDUKUNG

  @@map("coverage_level")
}

/// FR-X-018 · four-level information classification. No default (aturan 1).
enum Classification {
  PUBLIK
  INTERNAL
  TERBATAS
  RAHASIA

  @@map("classification")
}

/// FR-A-004 · engagement types.
enum EngagementType {
  AUDIT_INTERNAL
  AUDIT_EKSTERNAL
  PEMERIKSAAN_REGULATOR
  SELF_ASSESSMENT
  SERTIFIKASI
  AUDIT_INDUK
  TINJAUAN_MANAJEMEN

  @@map("engagement_type")
}

/// FR-A-005 · engagement lifecycle.
enum EngagementStatus {
  PERENCANAAN
  BERJALAN
  PELAPORAN
  SELESAI
  PEMANTAUAN
  DITUTUP
  DITANGGUHKAN
  DIBATALKAN

  @@map("engagement_status")
}

/// FR-A-007 · evidence-request lifecycle.
enum RequestItemStatus {
  DRAF
  TERBIT
  DISERAHKAN
  DALAM_PENELAAHAN
  INFO_TAMBAHAN
  SELESAI
  TIDAK_BERLAKU

  @@map("request_item_status")
}

/// FR-A-013 · evidence lifecycle.
enum EvidenceStatus {
  DRAF
  DISERAHKAN
  DITERIMA
  DITOLAK
  KEDALUWARSA
  DIARSIPKAN

  @@map("evidence_status")
}

/// FR-A-010 · where a piece of evidence came from.
enum EvidenceSource {
  UNGGAHAN_MANUAL
  KONEKTOR
  DIBANGKITKAN_SISTEM

  @@map("evidence_source")
}

/// FR-A-010 aturan 1 · what a piece of evidence can be linked to.
enum EvidenceLinkTarget {
  REQUEST_ITEM
  CONTROL
  FINDING
  ENGAGEMENT
  CAMPAIGN
  /// FR-C-021 aturan 2 · the attestation completion report is Modul A evidence
  /// and points back at the campaign it was computed from.
  ATTESTATION_CAMPAIGN

  @@map("evidence_link_target")
}

/// FR-A-017 · finding lifecycle.
enum FindingLifecycle {
  DRAF
  DIKOMUNIKASIKAN
  DISEPAKATI
  DISANGGAH
  DALAM_PERBAIKAN
  MENUNGGU_VERIFIKASI
  DITUTUP
  DITERIMA_SEBAGAI_RISIKO
  DIBATALKAN

  @@map("finding_lifecycle")
}

/// FR-A-018 · external-auditor access grant lifecycle.
enum ExternalAccessStatus {
  MENUNGGU_AKTIVASI
  AKTIF
  KEDALUWARSA
  DICABUT

  @@map("external_access_status")
}

/// Application registry subject to access review (FR-B-001). See
/// packages/db/README.md for the documented gap between this column list and
/// the FR-B-001 prose "Atribut" list (uraian/data classification/retrieval
/// method are not in the TRD ERD and are not added here).
model Application {
  id                   String          @id @db.Uuid
  code                 String          @unique(map: "uq_application_code") @db.VarChar(50)
  name                 String          @db.VarChar(200)
  ownerEmployeeId      String          @map("owner_employee_id") @db.Uuid
  techOwnerEmployeeId  String?         @map("tech_owner_employee_id") @db.Uuid
  criticality          RiskLevel
  hostingType          HostingType     @map("hosting_type")
  reviewFrequency      ReviewFrequency @map("review_frequency")
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerEmployee     Employee            @relation("ApplicationOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  techOwnerEmployee Employee?           @relation("ApplicationTechOwner", fields: [techOwnerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entitlements      EntitlementCatalog[]
  connectors        Connector[]
  snapshots         AccessSnapshot[]
  campaignScopes    CampaignScope[]
  revocationTickets RevocationTicket[]
  accessAnomalies   AccessAnomaly[]

  @@index([ownerEmployeeId], map: "idx_application_owner_employee_id")
  @@index([techOwnerEmployeeId], map: "idx_application_tech_owner_employee_id")
  @@map("application")
}

/// Per-application entitlement catalog (FR-B-002).
model EntitlementCatalog {
  id                  String          @id @db.Uuid
  applicationId       String          @map("application_id") @db.Uuid
  technicalCode       String          @map("technical_code") @db.VarChar(200)
  displayName         String          @map("display_name") @db.VarChar(200)
  businessDescription String?         @map("business_description")
  entitlementType     EntitlementType @map("entitlement_type")
  riskLevel           RiskLevel       @map("risk_level")
  isPrivileged        Boolean         @default(false) @map("is_privileged")
  isFinancial         Boolean         @default(false) @map("is_financial")
  isCategorized       Boolean         @default(false) @map("is_categorized")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application       Application        @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  snapshotLines     SnapshotLine[]
  revocationTickets RevocationTicket[]
  sodViolationsA    SodViolation[]     @relation("SodViolationEntitlementA")
  sodViolationsB    SodViolation[]     @relation("SodViolationEntitlementB")

  @@unique([applicationId, technicalCode], map: "uq_entitlement_catalog_app_technical_code")
  @@index([applicationId], map: "idx_entitlement_catalog_application_id")
  @@map("entitlement_catalog")
}

/// Access data retrieval configuration per application (FR-B-003, ADR-05).
/// Not in the ERD relation diagram with columns -- see migration.sql Sec 5
/// for the full design rationale, including why encryptedCredentials is
/// Bytes (pgcrypto ciphertext) rather than a plaintext column.
model Connector {
  id                        String                @id @db.Uuid
  applicationId             String                @map("application_id") @db.Uuid
  type                      ConnectorType
  name                      String                @db.VarChar(200)
  config                    Json                  @default("{}")
  encryptedCredentials      Bytes?                @map("encrypted_credentials")
  scheduleCron              String?               @map("schedule_cron") @db.VarChar(100)
  isActive                  Boolean               @default(true) @map("is_active")
  consecutiveFailureCount   Int                   @default(0) @map("consecutive_failure_count") @db.SmallInt
  lastTestedAt              DateTime?             @map("last_tested_at") @db.Timestamptz(6)
  lastTestResult            ConnectorTestResult?  @map("last_test_result")
  lastRunAt                 DateTime?             @map("last_run_at") @db.Timestamptz(6)
  lastRunStatus             ConnectorRunStatus?   @map("last_run_status")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([applicationId], map: "idx_connector_application_id")
  @@index([isActive], map: "idx_connector_is_active")
  @@map("connector")
}

/// Immutable point-in-time capture of one application's identities and
/// entitlements (FR-B-005, ADR-07).
model AccessSnapshot {
  id                String                 @id @db.Uuid
  applicationId     String                 @map("application_id") @db.Uuid
  capturedAt        DateTime               @map("captured_at") @db.Timestamptz(6)
  source            ConnectorType
  capturedBy        String?                @map("captured_by") @db.Uuid
  identityCount     Int                    @default(0) @map("identity_count")
  entitlementCount  Int                    @default(0) @map("entitlement_count")
  contentHash       String                 @map("content_hash") @db.VarChar(64)
  status            AccessSnapshotStatus   @default(MEMPROSES)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application         Application        @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capturedByUser      AppUser?           @relation(fields: [capturedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines               SnapshotLine[]
  verifiedRevocations RevocationTicket[]
  sodViolations       SodViolation[]
  accessAnomalies     AccessAnomaly[]

  @@index([applicationId], map: "idx_access_snapshot_application_id")
  @@index([applicationId, capturedAt(sort: Desc)], map: "idx_access_snapshot_app_captured_at")
  @@map("access_snapshot")
}

/// One row per (account, entitlement) held at capture time (FR-B-005,
/// ADR-07). Partitioned monthly by capturedAt in migration.sql -- NOT
/// expressible in Prisma schema language, see the Modul B header comment
/// above and the deviation note in migration.sql Sec 7. The primary key is
/// the composite (id, capturedAt), not id alone, because PostgreSQL requires
/// every unique constraint on a partitioned table to include the partition
/// key.
model SnapshotLine {
  id             String    @db.Uuid
  snapshotId     String    @map("snapshot_id") @db.Uuid
  capturedAt     DateTime  @map("captured_at") @db.Timestamptz(6)
  accountId      String    @map("account_id") @db.VarChar(200)
  accountName    String?   @map("account_name") @db.VarChar(200)
  entitlementId  String    @map("entitlement_id") @db.Uuid
  employeeId     String?   @map("employee_id") @db.Uuid
  accountStatus  String    @map("account_status") @db.VarChar(50)
  lastAccessAt   DateTime? @map("last_access_at") @db.Timestamptz(6)
  grantedAt      DateTime? @map("granted_at") @db.Date
  grantedBy      String?   @map("granted_by") @db.VarChar(200)

  snapshot    AccessSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entitlement EntitlementCatalog @relation(fields: [entitlementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee    Employee?          @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, capturedAt], map: "snapshot_line_pkey")
  @@index([snapshotId, employeeId], map: "idx_snapshot_line_snapshot_employee")
  @@index([snapshotId, entitlementId], map: "idx_snapshot_line_snapshot_entitlement")
  @@map("snapshot_line")
}

/// Access review campaign (FR-B-008..010).
model ReviewCampaign {
  id                  String         @id @db.Uuid
  code                String         @unique(map: "uq_review_campaign_code") @db.VarChar(50)
  name                String         @db.VarChar(200)
  campaignType        CampaignType   @map("campaign_type")
  startDate           DateTime       @map("start_date") @db.Date
  dueDate             DateTime       @map("due_date") @db.Date
  reviewerRule        Json           @map("reviewer_rule")
  fallbackReviewerId  String         @map("fallback_reviewer_id") @db.Uuid
  status              CampaignStatus @default(DRAF)
  extensionCount      Int            @default(0) @map("extension_count") @db.SmallInt
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fallbackReviewer AppUser           @relation(fields: [fallbackReviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scopes           CampaignScope[]
  items            ReviewItem[]
  signoffs         CampaignSignoff[]
  evidencePackage  CampaignEvidencePackage?

  @@index([fallbackReviewerId], map: "idx_review_campaign_fallback_reviewer_id")
  @@index([status], map: "idx_review_campaign_status")
  @@map("review_campaign")
}

/// Design decision (FR-B-008): one row per application in a campaign's
/// scope. See migration.sql Sec 9.
model CampaignScope {
  id             String   @id @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  scopeFilter    Json     @default("{}") @map("scope_filter")
  itemCount      Int?     @map("item_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign    ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([campaignId, applicationId], map: "uq_campaign_scope_campaign_application")
  @@index([campaignId], map: "idx_campaign_scope_campaign_id")
  @@map("campaign_scope")
}

/// One review item per (identity, entitlement) combination in a campaign's
/// scope (FR-B-011).
model ReviewItem {
  id               String            @id @db.Uuid
  campaignId       String            @map("campaign_id") @db.Uuid
  snapshotLineId   String            @map("snapshot_line_id") @db.Uuid
  reviewerId       String            @map("reviewer_id") @db.Uuid
  layerNo          Int               @default(1) @map("layer_no") @db.SmallInt
  status           ReviewItemStatus  @default(BELUM_DIPUTUSKAN)
  isFlagged        Boolean           @default(false) @map("is_flagged")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign ReviewCampaign  @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer AppUser         @relation(fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decision ReviewDecision?

  // snapshotLineId intentionally has NO @relation: snapshot_line is
  // partitioned and carries no database FOREIGN KEY from this column (see
  // migration.sql Sec 7/10 deviation notes). Referential integrity is
  // enforced in the application repository layer.

  @@index([campaignId, reviewerId, status], map: "idx_review_item_worklist")
  @@index([snapshotLineId], map: "idx_review_item_snapshot_line_id")
  @@map("review_item")
}

/// Reviewer decision for one review_item (FR-B-012). Critical controls K-2
/// (decision has NO @default), K-3 (reason format/required -- CHECK
/// constraints in migration.sql, not expressible here), K-4 (bulkApplied
/// NOT NULL, default false).
model ReviewDecision {
  id             String              @id @db.Uuid
  reviewItemId   String              @unique(map: "uq_review_decision_review_item_id") @map("review_item_id") @db.Uuid
  // K-2 (FR-B-012 rule 1): deliberately no @default -- see migration.sql
  // Sec 11 for the full rationale.
  decision       ReviewDecisionType
  reason         String?
  decidedBy      String              @map("decided_by") @db.Uuid
  onBehalfOf     String?             @map("on_behalf_of") @db.Uuid
  decidedAt      DateTime            @default(now()) @map("decided_at") @db.Timestamptz(6)
  // K-4 (FR-B-013 rule 5): NOT NULL, default false.
  bulkApplied    Boolean             @default(false) @map("bulk_applied")
  secondsSpent   Int                 @default(0) @map("seconds_spent")

  reviewItem        ReviewItem         @relation(fields: [reviewItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedByUser      AppUser           @relation("ReviewDecisionDecidedBy", fields: [decidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  onBehalfOfUser      AppUser?         @relation("ReviewDecisionOnBehalfOf", fields: [onBehalfOf], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revocationTickets   RevocationTicket[]

  @@index([decidedBy], map: "idx_review_decision_decided_by")
  @@map("review_decision")
}

/// Design decision (FR-B-015). Critical control K-9: contentFingerprint is
/// the SHA-256 fingerprint over the exact signed decision set.
model CampaignSignoff {
  id                  String    @id @db.Uuid
  campaignId          String    @map("campaign_id") @db.Uuid
  signedBy            String    @map("signed_by") @db.Uuid
  layerNo             Int       @default(1) @map("layer_no") @db.SmallInt
  signedAt            DateTime  @default(now()) @map("signed_at") @db.Timestamptz(6)
  ipAddress           String    @map("ip_address") @db.VarChar(45)
  decisionCounts      Json      @map("decision_counts")
  contentFingerprint  String    @map("content_fingerprint") @db.VarChar(64)
  isActive            Boolean   @default(true) @map("is_active")
  reopenedAt          DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenedBy          String?   @map("reopened_by") @db.Uuid
  reopenReason        String?   @map("reopen_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign     ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signedByUser AppUser        @relation("CampaignSignoffSignedBy", fields: [signedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reopenedByUser AppUser?     @relation("CampaignSignoffReopenedBy", fields: [reopenedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campaignId], map: "idx_campaign_signoff_campaign_id")
  @@map("campaign_signoff")
}

/// FR-B-022 / FR-B-023 · the frozen evidence pack of a closed campaign.
///
/// One per campaign (a campaign closes once, FR-B-010). `contents` is the
/// eight-section assembly frozen at generation time, and `contentHash` is the
/// pack's own fingerprint over it (rule 3) -- both are read back verbatim, not
/// recomputed, so the fingerprint keeps meaning after a later sign-off reopen
/// or a newer snapshot. `evidenceId` points at the Modul A Evidence entity the
/// pack was registered as: the FR-B-023 cross-module bridge.
model CampaignEvidencePackage {
  id           String   @id @db.Uuid
  campaignId   String   @unique(map: "uq_campaign_evidence_package_campaign") @map("campaign_id") @db.Uuid
  evidenceId   String   @map("evidence_id") @db.Uuid
  title        String   @db.VarChar(300)
  contentHash  String   @map("content_hash") @db.VarChar(64)
  contents     Json
  generatedBy  String   @map("generated_by") @db.Uuid
  generatedAt  DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  campaign        ReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidence        Evidence       @relation("CampaignEvidencePackageEvidence", fields: [evidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generatedByUser AppUser        @relation("CampaignEvidencePackageAuthor", fields: [generatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([evidenceId], map: "idx_campaign_evidence_package_evidence_id")
  @@map("campaign_evidence_package")
}

/// One ticket per signed-off Cabut/Ubah decision (FR-B-018). Critical
/// control K-1: TERVERIFIKASI_TERTUTUP requires verifiedBySnapshotId
/// (CHECK constraint chk_revocation_ticket_verified_requires_snapshot in
/// migration.sql, not expressible here -- the absence of any other path to
/// that status is itself the control).
model RevocationTicket {
  id                     String                   @id @db.Uuid
  decisionId             String                   @map("decision_id") @db.Uuid
  ticketNo               String                   @unique(map: "uq_revocation_ticket_ticket_no") @map("ticket_no") @db.VarChar(50)
  applicationId          String                   @map("application_id") @db.Uuid
  entitlementId          String                   @map("entitlement_id") @db.Uuid
  accountId              String                   @map("account_id") @db.VarChar(200)
  actionType             RevocationActionType     @map("action_type")
  assigneeId             String                   @map("assignee_id") @db.Uuid
  slaDueDate             DateTime                 @map("sla_due_date") @db.Date
  status                 RevocationTicketStatus   @default(TERBUKA)
  verifiedBySnapshotId   String?                  @map("verified_by_snapshot_id") @db.Uuid
  externalTicketRef      String?                  @map("external_ticket_ref") @db.VarChar(200)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  decision           ReviewDecision      @relation(fields: [decisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application        Application         @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entitlement        EntitlementCatalog  @relation(fields: [entitlementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee            Employee           @relation(fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedBySnapshot  AccessSnapshot?    @relation(fields: [verifiedBySnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([decisionId], map: "idx_revocation_ticket_decision_id")
  @@index([applicationId], map: "idx_revocation_ticket_application_id")
  @@index([verifiedBySnapshotId], map: "idx_revocation_ticket_verified_by_snapshot_id")
  @@index([assigneeId, status, slaDueDate], map: "idx_revocation_ticket_assignee_worklist")
  @@map("revocation_ticket")
}

/// Segregation-of-duties conflict rule (FR-B-024).
model SodRule {
  id                    String    @id @db.Uuid
  code                  String    @unique(map: "uq_sod_rule_code") @db.VarChar(50)
  name                  String    @db.VarChar(200)
  riskDescription       String    @map("risk_description")
  groupA                Json      @map("group_a")
  groupB                Json      @map("group_b")
  riskLevel             RiskLevel @map("risk_level")
  compensatingControl   String?   @map("compensating_control")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  violations SodViolation[]

  @@map("sod_rule")
}

/// Design decision (FR-B-024 rule 2, AN-08). See migration.sql Sec 15.
model SodViolation {
  id                     String        @id @db.Uuid
  ruleId                 String        @map("rule_id") @db.Uuid
  employeeId             String        @map("employee_id") @db.Uuid
  entitlementIdA         String        @map("entitlement_id_a") @db.Uuid
  entitlementIdB         String        @map("entitlement_id_b") @db.Uuid
  detectedInSnapshotId   String        @map("detected_in_snapshot_id") @db.Uuid
  detectedAt             DateTime      @default(now()) @map("detected_at") @db.Timestamptz(6)
  status                 FindingStatus @default(TERBUKA)
  resolvedAt             DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  rule               SodRule         @relation(fields: [ruleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entitlementA       EntitlementCatalog @relation("SodViolationEntitlementA", fields: [entitlementIdA], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entitlementB       EntitlementCatalog @relation("SodViolationEntitlementB", fields: [entitlementIdB], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detectedInSnapshot AccessSnapshot     @relation(fields: [detectedInSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exceptions         SodException[]

  @@index([employeeId], map: "idx_sod_violation_employee_id")
  @@index([ruleId], map: "idx_sod_violation_rule_id")
  @@index([status], map: "idx_sod_violation_status")
  @@map("sod_violation")
}

/// Design decision (FR-B-025). See migration.sql Sec 16.
model SodException {
  id                    String    @id @db.Uuid
  violationId           String    @map("violation_id") @db.Uuid
  businessReason        String    @map("business_reason")
  compensatingControl   String    @map("compensating_control")
  approvedBy            String    @map("approved_by") @db.Uuid
  approvedAt            DateTime  @default(now()) @map("approved_at") @db.Timestamptz(6)
  reviewDate            DateTime  @map("review_date") @db.Date
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  violation      SodViolation @relation(fields: [violationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedByUser AppUser      @relation(fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reviewDate], map: "idx_sod_exception_review_date")
  @@map("sod_exception")
}

/// Design decision (FR-B-007). See migration.sql Sec 17.
model AccessAnomaly {
  id                    String              @id @db.Uuid
  snapshotId            String              @map("snapshot_id") @db.Uuid
  snapshotLineId        String?             @map("snapshot_line_id") @db.Uuid
  employeeId            String?             @map("employee_id") @db.Uuid
  applicationId         String              @map("application_id") @db.Uuid
  code                  AccessAnomalyCode
  severity              RiskLevel
  firstDetectedAt       DateTime            @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt        DateTime            @default(now()) @map("last_detected_at") @db.Timestamptz(6)
  status                FindingStatus       @default(TERBUKA)
  exceptionReason       String?             @map("exception_reason")
  exceptionReviewDate   DateTime?           @map("exception_review_date") @db.Date
  resolvedAt            DateTime?           @map("resolved_at") @db.Timestamptz(6)
  details               Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  snapshot    AccessSnapshot @relation(fields: [snapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee    Employee?      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // snapshotLineId intentionally has NO @relation -- same reason as
  // ReviewItem.snapshotLineId above.

  @@index([snapshotId], map: "idx_access_anomaly_snapshot_id")
  @@index([applicationId, code], map: "idx_access_anomaly_application_code")
  @@index([employeeId], map: "idx_access_anomaly_employee_id")
  @@index([status], map: "idx_access_anomaly_status")
  @@map("access_anomaly")
}

// ============================================================================
// Modul A — Evidence Vault: control library and framework mapping.
// Requirements FR-A-001, FR-A-002, FR-A-003; docs/04-TRD.md Sec 3.2 ERD.
// Evidence, engagements, request items, findings and versions follow in a
// later migration; this migration builds the control/framework foundation
// everything else in Modul A references.
// ============================================================================

/// FR-A-001 · a managed enterprise control.
model Control {
  id                  String           @id @db.Uuid
  code                String           @unique(map: "uq_control_code") @db.VarChar(50)
  title               String           @db.VarChar(300)
  objective           String
  ownerEmployeeId     String           @map("owner_employee_id") @db.Uuid
  executingOrgUnitId  String?          @map("executing_org_unit_id") @db.Uuid
  frequency           ControlFrequency
  controlType         ControlType      @map("control_type")
  nature              ControlNature
  riskLevel           RiskLevel        @map("risk_level")
  testProcedure       String?          @map("test_procedure")
  expectedEvidenceTypes String[]       @map("expected_evidence_types")
  /// FR-A-001 aturan 2: the current version number; each edit to a used
  /// control bumps this and writes a ControlVersion snapshot.
  currentVersion      Int              @default(1) @map("current_version")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerEmployee    Employee          @relation("ControlOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executingOrgUnit OrganizationUnit? @relation("ControlExecutingUnit", fields: [executingOrgUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions         ControlVersion[]
  mappings         ControlMapping[]
  documentLinks    DocumentControlLink[]
  engagementScopes EngagementControl[]
  requestItems     RequestItem[]

  @@index([ownerEmployeeId], map: "idx_control_owner_employee_id")
  @@index([isActive], map: "idx_control_is_active")
  @@map("control")
}

/// FR-A-001 aturan 2 · an immutable snapshot of a control at a point in time.
/// A completed engagement keeps referring to the version that was in force,
/// so edits never rewrite history.
model ControlVersion {
  id            String   @id @db.Uuid
  controlId     String   @map("control_id") @db.Uuid
  versionNo     Int      @map("version_no")
  title         String   @db.VarChar(300)
  objective     String
  frequency     ControlFrequency
  controlType   ControlType @map("control_type")
  nature        ControlNature
  riskLevel     RiskLevel   @map("risk_level")
  testProcedure String?     @map("test_procedure")
  snapshot      Json        @default("{}")
  changedBy     String      @map("changed_by") @db.Uuid
  changedAt     DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  control       Control  @relation(fields: [controlId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changedByUser AppUser  @relation("ControlVersionAuthor", fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([controlId, versionNo], map: "uq_control_version_control_no")
  @@index([controlId], map: "idx_control_version_control_id")
  @@map("control_version")
}

/// FR-A-002 · a compliance framework (ISO 27001, OJK, COBIT, internal).
model Framework {
  id          String          @id @db.Uuid
  code        String          @unique(map: "uq_framework_code") @db.VarChar(50)
  name        String          @db.VarChar(300)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items FrameworkItem[]

  @@map("framework")
}

/// FR-A-002 aturan 2 · a hierarchical clause within a framework (bab → pasal →
/// ayat), of arbitrary depth via the self-referential parent.
model FrameworkItem {
  id          String  @id @db.Uuid
  frameworkId String  @map("framework_id") @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  ref         String  @db.VarChar(100)
  title       String  @db.VarChar(500)
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  framework Framework        @relation(fields: [frameworkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent    FrameworkItem?   @relation("FrameworkItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  FrameworkItem[]  @relation("FrameworkItemHierarchy")
  mappings  ControlMapping[]

  @@unique([frameworkId, ref], map: "uq_framework_item_framework_ref")
  @@index([frameworkId], map: "idx_framework_item_framework_id")
  @@index([parentId], map: "idx_framework_item_parent_id")
  @@map("framework_item")
}

/// FR-A-003 · many-to-many control ↔ framework item, with a coverage level.
model ControlMapping {
  id              String        @id @db.Uuid
  controlId       String        @map("control_id") @db.Uuid
  frameworkItemId String        @map("framework_item_id") @db.Uuid
  coverageLevel   CoverageLevel @map("coverage_level")
  note            String?
  mappedBy        String        @map("mapped_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  control       Control       @relation(fields: [controlId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  frameworkItem FrameworkItem @relation(fields: [frameworkItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mappedByUser  AppUser       @relation("ControlMappingAuthor", fields: [mappedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([controlId, frameworkItemId], map: "uq_control_mapping_control_item")
  @@index([controlId], map: "idx_control_mapping_control_id")
  @@index([frameworkItemId], map: "idx_control_mapping_framework_item_id")
  @@map("control_mapping")
}

// ============================================================================
// Modul A — Evidence Vault stage 2: engagements, evidence, request items,
// findings. FR-A-004..017; docs/04-TRD.md Sec 3.2 ERD.
// ============================================================================

/// FR-A-004 · an audit/assessment engagement.
model Engagement {
  id               String           @id @db.Uuid
  code             String           @unique(map: "uq_engagement_code") @db.VarChar(50)
  title            String           @db.VarChar(300)
  engagementType   EngagementType   @map("engagement_type")
  periodFrom       DateTime         @map("period_from") @db.Date
  periodTo         DateTime         @map("period_to") @db.Date
  fieldworkStart   DateTime?        @map("fieldwork_start") @db.Date
  fieldworkEnd     DateTime?        @map("fieldwork_end") @db.Date
  leadAuditorId    String           @map("lead_auditor_id") @db.Uuid
  status           EngagementStatus @default(PERENCANAAN)
  legalHold        Boolean          @default(false) @map("legal_hold")
  cancelReason     String?          @map("cancel_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  leadAuditor  AppUser              @relation("EngagementLead", fields: [leadAuditorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members      EngagementMember[]
  controls     EngagementControl[]
  requestItems RequestItem[]
  findings     Finding[]
  externalAccess ExternalAccess[]

  @@index([status], map: "idx_engagement_status")
  @@index([leadAuditorId], map: "idx_engagement_lead_auditor_id")
  @@map("engagement")
}

/// FR-A-004 aturan 3 · team membership; a member only sees their engagements.
model EngagementMember {
  id           String   @id @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       AppUser    @relation("EngagementMemberUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, userId], map: "uq_engagement_member")
  @@index([userId], map: "idx_engagement_member_user_id")
  @@map("engagement_member")
}

/// FR-A-004 · controls in scope of an engagement.
model EngagementControl {
  id           String   @id @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  controlId    String   @map("control_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control    Control    @relation(fields: [controlId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, controlId], map: "uq_engagement_control")
  @@index([controlId], map: "idx_engagement_control_control_id")
  @@map("engagement_control")
}

/// FR-A-010 · evidence as a first-class entity, not an attachment.
model Evidence {
  id               String         @id @db.Uuid
  title            String         @db.VarChar(300)
  description      String?
  evidenceType     String         @map("evidence_type") @db.VarChar(100)
  validityFrom     DateTime?      @map("validity_from") @db.Date
  validityTo       DateTime?      @map("validity_to") @db.Date
  ownerOrgUnitId   String?        @map("owner_org_unit_id") @db.Uuid
  classification   Classification
  source           EvidenceSource
  systemGenerated  Boolean        @default(false) @map("system_generated")
  status           EvidenceStatus @default(DRAF)
  currentVersionNo Int            @default(0) @map("current_version_no")
  /// FR-A-015 · retention. legalHold overrides all retention rules (rule 4).
  /// retentionUntil is set when the evidence's engagement closes; null means
  /// not yet subject to a retention clock. deletionApprovedAt records the
  /// COMPLIANCE approval that actually removed the object.
  legalHold        Boolean        @default(false) @map("legal_hold")
  retentionUntil   DateTime?      @map("retention_until") @db.Date
  deletionApprovedAt DateTime?    @map("deletion_approved_at") @db.Timestamptz(6)
  createdBy        String         @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerOrgUnit  OrganizationUnit? @relation("EvidenceOwnerUnit", fields: [ownerOrgUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser AppUser           @relation("EvidenceCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions      EvidenceVersion[]
  links         EvidenceLink[]
  campaignPackage CampaignEvidencePackage[] @relation("CampaignEvidencePackageEvidence")

  @@index([classification], map: "idx_evidence_classification")
  @@index([status], map: "idx_evidence_status")
  @@map("evidence")
}

/// FR-A-011 · an immutable version of an evidence file — critical control K-8.
model EvidenceVersion {
  id           String         @id @db.Uuid
  evidenceId   String         @map("evidence_id") @db.Uuid
  versionNo    Int            @map("version_no")
  storageKey   String         @map("storage_key") @db.VarChar(500)
  fileName     String         @map("file_name") @db.VarChar(300)
  fileSize     BigInt         @map("file_size")
  mimeType     String         @map("mime_type") @db.VarChar(200)
  sha256       String         @db.VarChar(64)
  uploadedBy   String         @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  supersededAt DateTime?      @map("superseded_at") @db.Timestamptz(6)
  scanStatus   FileScanStatus @default(MENUNGGU_PEMINDAIAN) @map("scan_status")

  evidence       Evidence @relation(fields: [evidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedByUser AppUser  @relation("EvidenceVersionUploader", fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([evidenceId, versionNo], map: "uq_evidence_version_no")
  @@unique([evidenceId, sha256], map: "uq_evidence_version_sha256")
  @@index([evidenceId], map: "idx_evidence_version_evidence_id")
  @@map("evidence_version")
}

/// FR-A-010/012 · a link from a piece of evidence to something it supports.
model EvidenceLink {
  id         String             @id @db.Uuid
  evidenceId String             @map("evidence_id") @db.Uuid
  targetType EvidenceLinkTarget @map("target_type")
  targetId   String             @map("target_id") @db.Uuid
  note       String?
  linkedBy   String             @map("linked_by") @db.Uuid
  linkedAt   DateTime           @default(now()) @map("linked_at") @db.Timestamptz(6)

  evidence     Evidence @relation(fields: [evidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedByUser AppUser  @relation("EvidenceLinkAuthor", fields: [linkedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([evidenceId, targetType, targetId], map: "uq_evidence_link_target")
  @@index([targetType, targetId], map: "idx_evidence_link_target")
  @@map("evidence_link")
}

/// FR-A-006 · an evidence request (PBC item) within an engagement.
model RequestItem {
  id                   String            @id @db.Uuid
  engagementId         String            @map("engagement_id") @db.Uuid
  sequenceNo           Int               @map("sequence_no")
  description          String
  controlId            String?           @map("control_id") @db.Uuid
  evidencePeriodFrom   DateTime?         @map("evidence_period_from") @db.Date
  evidencePeriodTo     DateTime?         @map("evidence_period_to") @db.Date
  responsibleOrgUnitId String?           @map("responsible_org_unit_id") @db.Uuid
  picEmployeeId        String            @map("pic_employee_id") @db.Uuid
  dueDate              DateTime          @map("due_date") @db.Date
  expectedEvidenceType String?           @map("expected_evidence_type") @db.VarChar(100)
  isMandatory          Boolean           @default(true) @map("is_mandatory")
  status               RequestItemStatus @default(DRAF)
  reviewNote           String?           @map("review_note")
  /// FR-A-018 aturan 3 · when an external auditor proposed this item, the
  /// EXTERNAL AppUser who did. A proposal starts DRAF and needs AUDITOR_INT to
  /// publish it, exactly like an internally authored request.
  proposedByExternalId String?           @map("proposed_by_external_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  engagement  Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control     Control?   @relation(fields: [controlId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  picEmployee Employee   @relation("RequestItemPic", fields: [picEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, sequenceNo], map: "uq_request_item_sequence")
  @@index([engagementId], map: "idx_request_item_engagement_id")
  @@index([picEmployeeId], map: "idx_request_item_pic_employee_id")
  @@index([status], map: "idx_request_item_status")
  @@map("request_item")
}

/// FR-A-016 · an audit finding.
model Finding {
  id             String           @id @db.Uuid
  engagementId   String           @map("engagement_id") @db.Uuid
  code           String           @unique(map: "uq_finding_code") @db.VarChar(50)
  title          String           @db.VarChar(300)
  conditionText  String           @map("condition_text")
  criteriaText   String?          @map("criteria_text")
  causeText      String?          @map("cause_text")
  effectText     String?          @map("effect_text")
  recommendation String?
  riskLevel      RiskLevel        @map("risk_level")
  ownerEmployeeId String?         @map("owner_employee_id") @db.Uuid
  dueDate        DateTime?        @map("due_date") @db.Date
  status         FindingLifecycle @default(DRAF)
  recurringOfId  String?          @map("recurring_of_id") @db.Uuid
  riskAcceptedBy String?          @map("risk_accepted_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  engagement    Engagement    @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerEmployee Employee?     @relation("FindingOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurringOf   Finding?      @relation("FindingRecurrence", fields: [recurringOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurrences   Finding[]     @relation("FindingRecurrence")
  remediations  Remediation[]

  @@index([engagementId], map: "idx_finding_engagement_id")
  @@index([status], map: "idx_finding_status")
  @@map("finding")
}

/// FR-A-017 · a remediation action tracked against a finding.
model Remediation {
  id           String    @id @db.Uuid
  findingId    String    @map("finding_id") @db.Uuid
  description  String
  ownerEmployeeId String @map("owner_employee_id") @db.Uuid
  dueDate      DateTime  @map("due_date") @db.Date
  verifiedBy   String?   @map("verified_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  finding       Finding  @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerEmployee Employee @relation("RemediationOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedByUser AppUser? @relation("RemediationVerifier", fields: [verifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([findingId], map: "idx_remediation_finding_id")
  @@map("remediation")
}

/// FR-A-018 · an external auditor's time-boxed access to one engagement.
///
/// Bridges an engagement to an EXTERNAL AppUser. The grant carries its own
/// access-until date (rule 7) independent of the AppUser.expiresAt, so an
/// auditor invited to two engagements can have different end dates for each.
/// Status is the lifecycle; revocation and expiry both close access.
model ExternalAccess {
  id            String               @id @db.Uuid
  engagementId  String               @map("engagement_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  email         String               @db.VarChar(320)
  fullName      String               @map("full_name") @db.VarChar(200)
  organization  String?              @db.VarChar(200)
  scopeNote     String?              @map("scope_note")
  accessUntil   DateTime             @map("access_until") @db.Date
  status        ExternalAccessStatus @default(MENUNGGU_AKTIVASI)
  invitedBy     String               @map("invited_by") @db.Uuid
  invitedAt     DateTime             @default(now()) @map("invited_at") @db.Timestamptz(6)
  revokedAt     DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  engagement  Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        AppUser    @relation("ExternalAccessUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedByUser AppUser  @relation("ExternalAccessInviter", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, userId], map: "uq_external_access_engagement_user")
  @@index([userId], map: "idx_external_access_user_id")
  @@index([status], map: "idx_external_access_status")
  @@map("external_access")
}

// ---------------------------------------------------------------------------
// Modul C -- Policy Hub (docs/04-TRD.md Sec 3.4)
//
// Mirrors migrations/20260828170000_module_c/migration.sql. The migration is
// the authority: it carries constraints Prisma cannot express (the partial
// unique index that allows only one BERLAKU version per document, the
// generated tsvector column, the HNSW index, and check_document_access).
// ---------------------------------------------------------------------------

/// FR-C-001 · the eight normative document types.
enum DocumentType {
  KEBIJAKAN
  PEDOMAN
  SOP
  INSTRUKSI_KERJA
  SURAT_EDARAN
  MEMO_INTERNAL
  FORMULIR
  LAMPIRAN_TEKNIS

  @@map("document_type")
}

/// FR-C-004 · the document lifecycle state machine.
enum DocumentStatus {
  DRAF
  DALAM_PENELAAHAN
  MENUNGGU_PENGESAHAN
  DISAHKAN
  BERLAKU
  DALAM_REVISI
  DIGANTIKAN
  DITARIK

  @@map("document_status")
}

/// FR-C-002 · process areas of a securities company.
enum ProcessArea {
  DEALING
  SETTLEMENT
  KUSTODIAN
  RISET
  PEMASARAN
  KEUANGAN_AKUNTANSI
  SDM
  TI
  KEPATUHAN
  MANAJEMEN_RISIKO
  AUDIT_INTERNAL
  UMUM

  @@map("process_area")
}

/// FR-C-010 aturan 2 · what an explicit document grant is addressed to.
enum DocumentAccessSubject {
  UNIT
  JABATAN
  PERAN
  KARYAWAN

  @@map("document_access_subject")
}

enum DocumentAccessLevel {
  BACA
  UNDUH

  @@map("document_access_level")
}

/// FR-C-001/002/003 · a normative document. Content lives on DocumentVersion.
model Document {
  id                String         @id @db.Uuid
  documentNo        String?        @unique(map: "document_document_no_key") @map("document_no") @db.VarChar(100)
  title             String         @db.VarChar(300)
  documentType      DocumentType   @map("document_type")
  ownerOrgUnitId    String         @map("owner_org_unit_id") @db.Uuid
  ownerEmployeeId   String         @map("owner_employee_id") @db.Uuid
  /// FR-X-018 aturan 1 & FR-C-003 aturan 1: no default, on purpose.
  classification    Classification
  processArea       ProcessArea    @map("process_area")
  tags              String[]       @default([])
  summary           String?
  reviewCycleMonths Int            @map("review_cycle_months")
  nextReviewDate    DateTime?      @map("next_review_date") @db.Date
  status            DocumentStatus @default(DRAF)
  supersededById    String?        @map("superseded_by_id") @db.Uuid
  withdrawnReason   String?        @map("withdrawn_reason")
  withdrawnAt       DateTime?      @map("withdrawn_at") @db.Timestamptz(6)
  createdBy         String         @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerOrgUnit  OrganizationUnit @relation("DocumentOwnerUnit", fields: [ownerOrgUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerEmployee Employee         @relation("DocumentOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy  Document?        @relation("DocumentSupersession", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes    Document[]       @relation("DocumentSupersession")
  createdByUser AppUser          @relation("DocumentAuthor", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions      DocumentVersion[]
  accessGrants  DocumentAccess[]
  controlLinks  DocumentControlLink[]
  attestationEntries AttestationCampaignDocument[]

  @@index([tags], map: "idx_document_tags", type: Gin)
  @@index([status, classification, ownerOrgUnitId], map: "idx_document_status_classification_unit")
  @@index([ownerEmployeeId], map: "idx_document_owner_employee_id")
  @@index([nextReviewDate], map: "idx_document_next_review_date")
  @@index([documentType, processArea], map: "idx_document_type_process_area")
  @@map("document")
}

/// FR-C-006/007 · one version of a document plus its force window.
model DocumentVersion {
  id             String         @id @db.Uuid
  documentId     String         @map("document_id") @db.Uuid
  versionMajor   Int            @map("version_major")
  versionMinor   Int            @map("version_minor")
  storageKey     String?        @map("storage_key") @db.VarChar(500)
  extractedText  String?        @map("extracted_text")
  body           String?
  changeSummary  String         @map("change_summary")
  effectiveFrom  DateTime?      @map("effective_from") @db.Date
  effectiveUntil DateTime?      @map("effective_until") @db.Date
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz(6)
  status         DocumentStatus @default(DRAF)
  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document      Document        @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser AppUser         @relation("DocumentVersionAuthor", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chunks        DocumentChunk[]
  approvalSteps DocumentApprovalStep[]
  attestationEntries AttestationCampaignDocument[]
  attestationRecords AttestationRecord[]

  @@unique([documentId, versionMajor, versionMinor], map: "uq_document_version_no")
  @@index([documentId], map: "idx_document_version_document_id")
  @@index([status], map: "idx_document_version_status")
  @@index([documentId, effectiveFrom, effectiveUntil], map: "idx_document_version_effective")
  @@map("document_version")
}

/// 04-TRD Sec 4.1 · a structure-aware chunk of one version.
///
/// `content_tsv` (generated) and `content_embedding` (vector(768)) exist in the
/// database but not here: Prisma models neither type. Search therefore runs as
/// raw SQL in the repository, which is where it belongs anyway -- the ranking
/// query in 04-TRD Sec 4.2 is not expressible through the query builder.
model DocumentChunk {
  id                String   @id @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  chunkIndex        Int      @map("chunk_index")
  sectionRef        String?  @map("section_ref") @db.VarChar(200)
  content           String
  tokenCount        Int?     @map("token_count")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([documentVersionId, chunkIndex], map: "uq_document_chunk_version_index")
  @@index([documentVersionId], map: "idx_document_chunk_version_id")
  @@map("document_chunk")
}

/// FR-C-010 aturan 2 · an explicit grant on a document.
model DocumentAccess {
  id          String                @id @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  subjectType DocumentAccessSubject @map("subject_type")
  subjectId   String?               @map("subject_id") @db.Uuid
  subjectName String?               @map("subject_name") @db.VarChar(200)
  accessLevel DocumentAccessLevel   @default(BACA) @map("access_level")
  grantedBy   String                @map("granted_by") @db.Uuid
  grantedAt   DateTime              @default(now()) @map("granted_at") @db.Timestamptz(6)

  document      Document @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedByUser AppUser  @relation("DocumentAccessGranter", fields: [grantedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([documentId], map: "idx_document_access_document_id")
  @@index([subjectType, subjectId], map: "idx_document_access_subject")
  @@map("document_access")
}

/// FR-C-022 · a document underpinning a Modul A audit control.
model DocumentControlLink {
  id         String   @id @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  controlId  String   @map("control_id") @db.Uuid
  note       String?
  linkedBy   String   @map("linked_by") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  document     Document @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control      Control  @relation(fields: [controlId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedByUser AppUser  @relation("DocumentControlLinker", fields: [linkedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([documentId, controlId], map: "uq_document_control_link")
  @@index([controlId], map: "idx_document_control_link_control_id")
  @@map("document_control_link")
}

/// FR-C-012 aturan 4 · a search that returned nothing, kept for content-gap
/// analysis. Not an audit event, so deliberately not in audit_log.
model DocumentSearchMiss {
  id         BigInt   @id @default(autoincrement())
  queryText  String   @map("query_text")
  userId     String?  @map("user_id") @db.Uuid
  filters    Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user AppUser? @relation("DocumentSearchMissUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurredAt(sort: Desc)], map: "idx_document_search_miss_occurred_at")
  @@map("document_search_miss")
}

// ---------------------------------------------------------------------------
// Modul C -- alur persetujuan berjenjang (FR-C-005)
//
// Mirrors migrations/20260828180000_module_c_approval/migration.sql. That file
// is the authority: it carries the CHECK constraints Prisma cannot express,
// notably the one refusing a rejection with no recorded reason.
// ---------------------------------------------------------------------------

/// FR-C-005 aturan 1 & 2 · reviewers may run in parallel, approvers never do.
enum ApprovalStepKind {
  PENELAAHAN
  PENGESAHAN

  @@map("approval_step_kind")
}

enum ApprovalStepStatus {
  MENUNGGU
  SETUJU
  DIKEMBALIKAN
  DITOLAK
  DILEWATI
  DIBATALKAN

  @@map("approval_step_status")
}

/// FR-C-005 · the configurable ladder, per document type and (optionally) unit.
model DocumentApprovalTemplate {
  id           String           @id @db.Uuid
  documentType DocumentType     @map("document_type")
  orgUnitId    String?          @map("org_unit_id") @db.Uuid
  kind         ApprovalStepKind
  stepOrder    Int              @map("step_order")
  employeeId   String?          @map("employee_id") @db.Uuid
  roleCode     String?          @map("role_code") @db.VarChar(50)
  /// FR-C-006 aturan 2 · skippable for an editorial (minor) revision.
  skipOnMinor  Boolean          @default(false) @map("skip_on_minor")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  orgUnit  OrganizationUnit? @relation("DocumentApprovalTemplateUnit", fields: [orgUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee?         @relation("DocumentApprovalTemplateEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("document_approval_template")
}

/// FR-C-005 · one concrete step on one version, frozen when the flow starts.
model DocumentApprovalStep {
  id                       String             @id @db.Uuid
  documentVersionId        String             @map("document_version_id") @db.Uuid
  kind                     ApprovalStepKind
  stepOrder                Int                @map("step_order")
  /// Which submission attempt this step belongs to. A rejected flow keeps its
  /// steps; the next submission opens a new round. See the migration.
  round                    Int                @default(1)
  assigneeEmployeeId       String             @map("assignee_employee_id") @db.Uuid
  redirectedFromEmployeeId String?            @map("redirected_from_employee_id") @db.Uuid
  redirectReason           String?            @map("redirect_reason") @db.VarChar(200)
  status                   ApprovalStepStatus @default(MENUNGGU)
  comment                  String?
  actedBy                  String?            @map("acted_by") @db.Uuid
  actedAt                  DateTime?          @map("acted_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  version          DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee         Employee        @relation("DocumentApprovalAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  redirectedFrom   Employee?       @relation("DocumentApprovalRedirectedFrom", fields: [redirectedFromEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actedByUser      AppUser?        @relation("DocumentApprovalActor", fields: [actedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([documentVersionId, round, kind, stepOrder, assigneeEmployeeId], map: "uq_document_approval_step_slot")
  @@index([documentVersionId, kind, stepOrder], map: "idx_document_approval_step_version")
  @@map("document_approval_step")
}

// ---------------------------------------------------------------------------
// Modul C -- kampanye attestation (FR-C-019 s.d. FR-C-021)
//
// Mirrors migrations/20260828190000_module_c_attestation/migration.sql, which
// is the authority. Note especially the grant asymmetry it carries:
// attestation_record has INSERT and SELECT only, because FR-C-020 aturan 3 says
// a statement cannot be withdrawn, and a grant guarantees that far more
// strongly than a service method that happens not to offer deletion.
// ---------------------------------------------------------------------------

enum AttestationCampaignStatus {
  DRAF
  BERJALAN
  SELESAI
  DIBATALKAN

  @@map("attestation_campaign_status")
}

/// FR-C-019 · who a campaign targets.
enum AttestationTargetKind {
  SELURUH_KARYAWAN
  UNIT
  JABATAN
  KARYAWAN_BARU
  DAFTAR_INDIVIDU

  @@map("attestation_target_kind")
}

enum AttestationTaskStatus {
  MENUNGGU
  SELESAI
  PERLU_NYATAKAN_ULANG
  DIBATALKAN

  @@map("attestation_task_status")
}

/// FR-C-019 · a read-and-acknowledge campaign.
model AttestationCampaign {
  id          String                    @id @db.Uuid
  name        String                    @db.VarChar(300)
  description String?
  targetKind  AttestationTargetKind     @map("target_kind")
  targetParams Json                     @default("{}") @map("target_params")
  startDate   DateTime                  @map("start_date") @db.Date
  dueDate     DateTime                  @map("due_date") @db.Date
  isMandatory Boolean                   @default(true) @map("is_mandatory")
  /// FR-C-019 aturan 3 · off by default; see the migration for why.
  autoEnrollNewEmployees Boolean        @default(false) @map("auto_enroll_new_employees")
  status      AttestationCampaignStatus @default(DRAF)
  launchedAt  DateTime?                 @map("launched_at") @db.Timestamptz(6)
  closedAt    DateTime?                 @map("closed_at") @db.Timestamptz(6)
  createdBy   String                    @map("created_by") @db.Uuid
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser AppUser                         @relation("AttestationCampaignCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents     AttestationCampaignDocument[]
  tasks         AttestationTask[]

  @@index([status], map: "idx_attestation_campaign_status")
  @@index([dueDate], map: "idx_attestation_campaign_due_date")
  @@map("attestation_campaign")
}

/// FR-C-019 aturan 1 & 2 · one document in a campaign, pinned to the version
/// that was in force when the campaign launched.
model AttestationCampaignDocument {
  id                     String    @id @db.Uuid
  campaignId             String    @map("campaign_id") @db.Uuid
  documentId             String    @map("document_id") @db.Uuid
  versionId              String    @map("version_id") @db.Uuid
  supersededNoticedAt    DateTime? @map("superseded_noticed_at") @db.Timestamptz(6)
  reattestationRequired  Boolean   @default(false) @map("reattestation_required")
  reattestationDecidedAt DateTime? @map("reattestation_decided_at") @db.Timestamptz(6)
  reattestationDecidedBy String?   @map("reattestation_decided_by") @db.Uuid

  campaign   AttestationCampaign @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document   Document            @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version    DocumentVersion     @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedBy  AppUser?            @relation("AttestationReattestationDecider", fields: [reattestationDecidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks      AttestationTask[]

  @@unique([campaignId, documentId], map: "uq_attestation_campaign_document")
  @@index([campaignId], map: "idx_attestation_campaign_document_campaign")
  @@map("attestation_campaign_document")
}

/// FR-C-019/021 · one obligation. Kept separate from the record so that
/// "has not attested" is representable.
model AttestationTask {
  id                 String                @id @db.Uuid
  campaignId         String                @map("campaign_id") @db.Uuid
  campaignDocumentId String                @map("campaign_document_id") @db.Uuid
  employeeId         String                @map("employee_id") @db.Uuid
  status             AttestationTaskStatus @default(MENUNGGU)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign         AttestationCampaign         @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignDocument AttestationCampaignDocument @relation(fields: [campaignDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee         Employee                    @relation("AttestationTaskEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  records          AttestationRecord[]

  @@unique([campaignDocumentId, employeeId], map: "uq_attestation_task")
  @@index([campaignId, status], map: "idx_attestation_task_campaign_status")
  @@map("attestation_task")
}

/// FR-C-020 · the statement, with the evidence that makes it mean something.
model AttestationRecord {
  id                String    @id @db.Uuid
  taskId            String    @map("task_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  /// The VERSION attested to. Someone who read 1.0 has not read 2.0.
  documentVersionId String    @map("document_version_id") @db.Uuid
  attestedAt        DateTime  @default(now()) @map("attested_at") @db.Timestamptz(6)
  ipAddress         String?   @map("ip_address") @db.Inet
  secondsViewed     Int       @map("seconds_viewed")
  reachedEnd        Boolean   @default(false) @map("reached_end")
  /// FR-C-020 aturan 3 · a correction is a new record naming the old one.
  correctsRecordId  String?   @map("corrects_record_id") @db.Uuid
  correctionReason  String?   @map("correction_reason")

  task     AttestationTask     @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee            @relation("AttestationRecordEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version  DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corrects AttestationRecord?  @relation("AttestationCorrection", fields: [correctsRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  correctedBy AttestationRecord[] @relation("AttestationCorrection")

  @@index([taskId], map: "idx_attestation_record_task")
  @@index([employeeId], map: "idx_attestation_record_employee")
  @@map("attestation_record")
}
