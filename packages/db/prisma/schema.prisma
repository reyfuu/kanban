// SIGAP -- Phase 1 foundation schema.
//
// Source of truth: docs/04-TRD.md Sec 3.1 (shared foundation ERD) and the
// design-decision table in Sec 3.5. Tables not shown in the ERD with full
// columns (permission, role_permission, delegation, notification,
// notification_preference, session, uploaded_file) are designed against
// docs/03-FRD.md FR-X-005/007/010/011/013 and docs/07-API-CONTRACT.md.
// See packages/db/README.md for the list of deliberate deviations from the
// ERD and the reasoning behind each one.
//
// Single legal entity (docs/04-TRD.md Sec 10 row 6, docs/01-BRD.md ASM-01):
// no entity_id / legal_entity_id column exists anywhere in this schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Two URLs, two roles -- this separation IS critical control K-7, not tidiness.
//
// `url` is the runtime connection and must be the `sigap_app` role: INSERT and
// SELECT on audit_log, nothing more.
//
// `directUrl` is used only by `prisma migrate` and must be a DIFFERENT role
// with DDL rights. The reason is that whichever role runs the migration ends up
// owning the objects it creates, and in PostgreSQL an owner holds every grant
// option on them permanently. If sigap_app runs the migration, it owns
// audit_log, and it can then grant UPDATE/DELETE back to itself, drop the
// immutability triggers, and empty the table -- three statements, no elevated
// privileges. Every other layer of K-7 assumes this did not happen.
//
// The migration hands audit_log to a NOLOGIN role at the end, which closes the
// window even for the migration role. See Sec 2b of the foundation migration.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATE_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, btree_gin, vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// FR-X-001 (AD-backed) vs FR-X-004 (invited external auditor account).
enum AppUserType {
  INTERNAL
  EXTERNAL

  @@map("app_user_type")
}

/// FR-X-013 rule 4. Closed set defined by 07-API-CONTRACT.md Sec 3.7/3.8.
enum FileScanStatus {
  MENUNGGU_PEMINDAIAN
  BERSIH
  TERINFEKSI
  GAGAL_PINDAI

  @@map("file_scan_status")
}

/// FR-X-010 rule 2.
enum NotificationFrequency {
  SEKETIKA
  RINGKASAN_HARIAN
  RINGKASAN_MINGGUAN

  @@map("notification_frequency")
}

// ---------------------------------------------------------------------------
// Shared foundation -- docs/04-TRD.md Sec 3.1
// ---------------------------------------------------------------------------

model OrganizationUnit {
  id        String   @id @db.Uuid
  code      String   @unique
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent    OrganizationUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgUnitHierarchy")
  employees Employee[]

  @@map("organization_unit")
}

model Employee {
  id               String    @id @db.Uuid
  employeeNumber   String    @unique @map("employee_number")
  fullName         String    @map("full_name")
  email            String
  jobTitle         String    @map("job_title")
  orgUnitId        String    @map("org_unit_id") @db.Uuid
  managerId        String?   @map("manager_id") @db.Uuid
  employmentStatus String    @map("employment_status")
  joinedAt         DateTime  @map("joined_at") @db.Date
  terminatedAt     DateTime? @map("terminated_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit OrganizationUnit @relation(fields: [orgUnitId], references: [id])
  manager Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  reports Employee[]       @relation("EmployeeManager")
  appUser AppUser?

  @@map("employee")
}

model AppUser {
  id          String      @id @db.Uuid
  employeeId  String?     @unique @map("employee_id") @db.Uuid
  externalId  String      @unique @map("external_id")
  userType    AppUserType @map("user_type")
  isActive    Boolean     @default(true) @map("is_active")
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz(6)
  lastLoginAt DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee               Employee?               @relation(fields: [employeeId], references: [id])
  userRoles              UserRole[]
  delegationsGiven       Delegation[]            @relation("DelegationFrom")
  delegationsReceived    Delegation[]            @relation("DelegationTo")
  sessions               Session[]               @relation("SessionUser")
  sessionsRevokedByMe    Session[]               @relation("SessionRevokedBy")
  uploadedFiles          UploadedFile[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogEntries        AuditLog[]              @relation("AuditActor")

  @@map("app_user")
}

model Role {
  id        String   @id @db.Uuid
  code      String   @unique
  name      String
  scopeType Json     @default("[]") @map("scope_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model UserRole {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  scope      Json?
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])
  role Role    @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

/// bigserial: append-only, chained, volume-driven exception (docs/04-TRD.md
/// Sec 3.5). See packages/db/README.md for the columns added beyond the ERD
/// (actorRoleAtAction, sessionId, requestId) per FR-X-008 rule 1.
model AuditLog {
  id                BigInt   @id @default(autoincrement())
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId           String   @map("actor_id") @db.Uuid
  actorRoleAtAction String[] @map("actor_role_at_action")
  sessionId         String?  @map("session_id") @db.Uuid
  requestId         String?  @map("request_id")
  action            String   @db.VarChar(100)
  objectType        String   @map("object_type") @db.VarChar(50)
  objectId          String   @map("object_id") @db.Uuid
  beforeValue       Json?    @map("before_value")
  afterValue        Json?    @map("after_value")
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  prevHash          String?  @map("prev_hash")
  hash              String

  actor   AppUser  @relation("AuditActor", fields: [actorId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([objectType, objectId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([sessionId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Authorization -- FR-X-005, FR-X-007 (columns not enumerated in the ERD;
// designed against FRD/API-CONTRACT, see packages/db/README.md)
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique
  name        String
  description String?
  module      String?  @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String   @id @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Delegation {
  id         String    @id @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime  @map("valid_until") @db.Date
  scope      String[]
  reason     String
  isActive   Boolean   @default(true) @map("is_active")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromUser AppUser @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUser   AppUser @relation("DelegationTo", fields: [toUserId], references: [id])

  @@index([toUserId, isActive])
  @@index([fromUserId])
  @@map("delegation")
}

// ---------------------------------------------------------------------------
// Session -- FR-X-002 (not in ERD; persisted so idle/absolute timeout and
// remote termination can be enforced server-side, not via stateless JWT)
// ---------------------------------------------------------------------------

model Session {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  ipAddress         String    @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent")
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(64)
  isActive          Boolean   @default(true) @map("is_active")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId   String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason      String?   @map("revoke_reason") @db.VarChar(40)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            AppUser    @relation("SessionUser", fields: [userId], references: [id])
  revokedByUser   AppUser?   @relation("SessionRevokedBy", fields: [revokedByUserId], references: [id])
  auditLogEntries AuditLog[]

  @@index([userId, isActive])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Uploaded file -- FR-X-013 (not in ERD; generic upload/scan tracking used
// later by Modul A evidence versions and Modul C document versions)
// ---------------------------------------------------------------------------

model UploadedFile {
  id                String         @id @db.Uuid
  uploadedByUserId  String         @map("uploaded_by_user_id") @db.Uuid
  originalFileName  String         @map("original_file_name")
  sanitizedFileName String         @map("sanitized_file_name")
  storageKey        String         @unique @map("storage_key")
  fileSize          BigInt         @map("file_size")
  declaredMimeType  String?        @map("declared_mime_type") @db.VarChar(255)
  detectedMimeType  String?        @map("detected_mime_type") @db.VarChar(255)
  sha256            String         @db.VarChar(64)
  scanStatus        FileScanStatus @default(MENUNGGU_PEMINDAIAN) @map("scan_status")
  scanCompletedAt   DateTime?      @map("scan_completed_at") @db.Timestamptz(6)
  scanEngineVersion String?        @map("scan_engine_version") @db.VarChar(100)
  quarantinedAt     DateTime?      @map("quarantined_at") @db.Timestamptz(6)
  purpose           String         @db.VarChar(30)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy AppUser @relation(fields: [uploadedByUserId], references: [id])

  @@index([sha256])
  @@index([scanStatus])
  @@index([uploadedByUserId])
  @@map("uploaded_file")
}

// ---------------------------------------------------------------------------
// Notification -- FR-X-010, FR-X-011 (not in ERD)
// ---------------------------------------------------------------------------

model Notification {
  id              String    @id @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  code            String    @db.VarChar(10)
  title           String
  body            String?
  objectType      String?   @map("object_type") @db.VarChar(50)
  objectId        String?   @map("object_id") @db.Uuid
  canBeSummarized Boolean   @map("can_be_summarized")
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  emailStatus     String    @default("TIDAK_BERLAKU") @map("email_status") @db.VarChar(20)
  emailAttempts   Int       @default(0) @map("email_attempts") @db.SmallInt
  emailFailedAt   DateTime? @map("email_failed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient AppUser @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId, isRead])
  @@index([code])
  @@index([objectType, objectId])
  @@map("notification")
}

model NotificationPreference {
  id                String                @id @db.Uuid
  userId            String                @unique @map("user_id") @db.Uuid
  defaultFrequency  NotificationFrequency @default(SEKETIKA) @map("default_frequency")
  categoryOverrides Json                  @default("{}") @map("category_overrides")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id])

  @@map("notification_preference")
}
