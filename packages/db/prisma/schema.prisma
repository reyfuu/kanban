// SIGAP -- Phase 1 foundation schema.
//
// Source of truth: docs/04-TRD.md Sec 3.1 (shared foundation ERD) and the
// design-decision table in Sec 3.5. Tables not shown in the ERD with full
// columns (permission, role_permission, delegation, notification,
// notification_preference, session, uploaded_file) are designed against
// docs/03-FRD.md FR-X-005/007/010/011/013 and docs/07-API-CONTRACT.md.
// See packages/db/README.md for the list of deliberate deviations from the
// ERD and the reasoning behind each one.
//
// Single legal entity (docs/04-TRD.md Sec 10 row 6, docs/01-BRD.md ASM-01):
// no entity_id / legal_entity_id column exists anywhere in this schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Two URLs, two roles -- this separation IS critical control K-7, not tidiness.
//
// `url` is the runtime connection and must be the `sigap_app` role: INSERT and
// SELECT on audit_log, nothing more.
//
// `directUrl` is used only by `prisma migrate` and must be a DIFFERENT role
// with DDL rights. The reason is that whichever role runs the migration ends up
// owning the objects it creates, and in PostgreSQL an owner holds every grant
// option on them permanently. If sigap_app runs the migration, it owns
// audit_log, and it can then grant UPDATE/DELETE back to itself, drop the
// immutability triggers, and empty the table -- three statements, no elevated
// privileges. Every other layer of K-7 assumes this did not happen.
//
// The migration hands audit_log to a NOLOGIN role at the end, which closes the
// window even for the migration role. See Sec 2b of the foundation migration.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATE_DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, btree_gin, vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// FR-X-001 (AD-backed) vs FR-X-004 (invited external auditor account).
enum AppUserType {
  INTERNAL
  EXTERNAL

  @@map("app_user_type")
}

/// FR-X-013 rule 4. Closed set defined by 07-API-CONTRACT.md Sec 3.7/3.8.
enum FileScanStatus {
  MENUNGGU_PEMINDAIAN
  BERSIH
  TERINFEKSI
  GAGAL_PINDAI

  @@map("file_scan_status")
}

/// FR-X-010 rule 2.
enum NotificationFrequency {
  SEKETIKA
  RINGKASAN_HARIAN
  RINGKASAN_MINGGUAN

  @@map("notification_frequency")
}

// ---------------------------------------------------------------------------
// Shared foundation -- docs/04-TRD.md Sec 3.1
// ---------------------------------------------------------------------------

model OrganizationUnit {
  id        String   @id @db.Uuid
  code      String   @unique(map: "uq_organization_unit_code") @db.VarChar(50)
  name      String   @db.VarChar(200)
  parentId  String?  @map("parent_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // onDelete/onUpdate spelled out (see AuditLog above for why): migration.sql
  // writes every foreign key with no action clause, i.e. NO ACTION, but
  // Prisma's default for an optional relation is SetNull.
  parent    OrganizationUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  OrganizationUnit[] @relation("OrgUnitHierarchy")
  employees Employee[]
  executedControls Control[]   @relation("ControlExecutingUnit")
  ownedEvidence    Evidence[]   @relation("EvidenceOwnerUnit")

  // Modul C (docs/04-TRD.md Sec 3.4) back-relations.
  ownedDocuments   Document[]   @relation("DocumentOwnerUnit")
  approvalTemplates DocumentApprovalTemplate[] @relation("DocumentApprovalTemplateUnit")

  @@index([parentId], map: "idx_organization_unit_parent_id")
  @@map("organization_unit")
}

model Employee {
  id               String    @id @db.Uuid
  employeeNumber   String    @unique(map: "uq_employee_employee_number") @map("employee_number") @db.VarChar(50)
  fullName         String    @map("full_name") @db.VarChar(200)
  email            String    @db.VarChar(320)
  jobTitle         String    @map("job_title") @db.VarChar(200)
  orgUnitId        String    @map("org_unit_id") @db.Uuid
  managerId        String?   @map("manager_id") @db.Uuid
  employmentStatus String    @map("employment_status") @db.VarChar(30)
  joinedAt         DateTime  @map("joined_at") @db.Date
  terminatedAt     DateTime? @map("terminated_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit OrganizationUnit @relation(fields: [orgUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports Employee[]       @relation("EmployeeManager")
  appUser AppUser?

  // Modul B (docs/04-TRD.md Sec 3.3) back-relations.
  ownedApplications      Application[]      @relation("ApplicationOwner")
  techOwnedApplications  Application[]      @relation("ApplicationTechOwner")
  snapshotLines          SnapshotLine[]
  assignedRevocations    RevocationTicket[]
  sodViolations          SodViolation[]
  accessAnomalies        AccessAnomaly[]

  // Modul A (docs/04-TRD.md Sec 3.2) back-relations.
  ownedControls          Control[]          @relation("ControlOwner")
  requestItemsAsPic      RequestItem[]      @relation("RequestItemPic")
  ownedFindings          Finding[]          @relation("FindingOwner")
  ownedRemediations      Remediation[]      @relation("RemediationOwner")

  // Modul C (docs/04-TRD.md Sec 3.4) back-relations.
  ownedDocuments         Document[]         @relation("DocumentOwner")
  approvalTemplateSlots  DocumentApprovalTemplate[] @relation("DocumentApprovalTemplateEmployee")
  approvalStepsAssigned  DocumentApprovalStep[]     @relation("DocumentApprovalAssignee")
  approvalStepsRedirected DocumentApprovalStep[]    @relation("DocumentApprovalRedirectedFrom")
  attestationTasks       AttestationTask[]          @relation("AttestationTaskEmployee")
  attestationRecords     AttestationRecord[]        @relation("AttestationRecordEmployee")

  @@index([orgUnitId], map: "idx_employee_org_unit_id")
  @@index([managerId], map: "idx_employee_manager_id")
  @@index([email], map: "idx_employee_email")
  @@map("employee")
}

model AppUser {
  id          String      @id @db.Uuid
  employeeId  String?     @unique(map: "uq_app_user_employee_id") @map("employee_id") @db.Uuid
  externalId  String      @unique(map: "uq_app_user_external_id") @map("external_id") @db.VarChar(200)
  userType    AppUserType @map("user_type")
  isActive    Boolean     @default(true) @map("is_active")
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz(6)
  lastLoginAt DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee               Employee?               @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles              UserRole[]
  delegationsGiven       Delegation[]            @relation("DelegationFrom")
  delegationsReceived    Delegation[]            @relation("DelegationTo")
  sessions               Session[]               @relation("SessionUser")
  sessionsRevokedByMe    Session[]               @relation("SessionRevokedBy")
  uploadedFiles          UploadedFile[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogEntries        AuditLog[]              @relation("AuditActor")

  // Modul B (docs/04-TRD.md Sec 3.3) back-relations.
  capturedSnapshots         AccessSnapshot[]
  fallbackForCampaigns      ReviewCampaign[]
  reviewItems               ReviewItem[]
  decidedReviewDecisions    ReviewDecision[]   @relation("ReviewDecisionDecidedBy")
  onBehalfReviewDecisions   ReviewDecision[]   @relation("ReviewDecisionOnBehalfOf")
  signedCampaignSignoffs    CampaignSignoff[]  @relation("CampaignSignoffSignedBy")
  reopenedCampaignSignoffs  CampaignSignoff[]  @relation("CampaignSignoffReopenedBy")
  approvedSodExceptions     SodException[]
  generatedEvidencePackages CampaignEvidencePackage[] @relation("CampaignEvidencePackageAuthor")

  // Modul A (docs/04-TRD.md Sec 3.2) back-relations.
  authoredControlVersions   ControlVersion[]   @relation("ControlVersionAuthor")
  authoredControlMappings   ControlMapping[]   @relation("ControlMappingAuthor")
  ledEngagements            Engagement[]       @relation("EngagementLead")
  engagementMemberships     EngagementMember[] @relation("EngagementMemberUser")
  createdEvidence           Evidence[]         @relation("EvidenceCreator")
  uploadedEvidenceVersions  EvidenceVersion[]  @relation("EvidenceVersionUploader")
  authoredEvidenceLinks     EvidenceLink[]     @relation("EvidenceLinkAuthor")
  verifiedRemediations      Remediation[]      @relation("RemediationVerifier")
  externalAccessGrants      ExternalAccess[]   @relation("ExternalAccessUser")
  externalAccessInvited     ExternalAccess[]   @relation("ExternalAccessInviter")

  // Modul C (docs/04-TRD.md Sec 3.4) back-relations.
  authoredDocuments         Document[]            @relation("DocumentAuthor")
  authoredDocumentVersions  DocumentVersion[]     @relation("DocumentVersionAuthor")
  grantedDocumentAccess     DocumentAccess[]      @relation("DocumentAccessGranter")
  linkedDocumentControls    DocumentControlLink[] @relation("DocumentControlLinker")
  documentSearchMisses      DocumentSearchMiss[]  @relation("DocumentSearchMissUser")
  documentApprovalActions   DocumentApprovalStep[] @relation("DocumentApprovalActor")
  attestationCampaigns      AttestationCampaign[]  @relation("AttestationCampaignCreator")
  attestationReattestDecisions AttestationCampaignDocument[] @relation("AttestationReattestationDecider")

  @@index([isActive], map: "idx_app_user_is_active")
  @@map("app_user")
}

model Role {
  id        String   @id @db.Uuid
  code      String   @unique(map: "uq_role_code") @db.VarChar(50)
  name      String   @db.VarChar(200)
  scopeType Json     @default("[]") @map("scope_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model UserRole {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  scope      Json?
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role    @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_user_role_user_id")
  @@index([roleId], map: "idx_user_role_role_id")
  @@index([userId, validFrom, validUntil], map: "idx_user_role_active_period")
  @@map("user_role")
}

/// bigserial: append-only, chained, volume-driven exception (docs/04-TRD.md
/// Sec 3.5). See packages/db/README.md for the columns added beyond the ERD
/// (actorRoleAtAction, sessionId, requestId) per FR-X-008 rule 1.
model AuditLog {
  id                BigInt   @id @default(autoincrement())
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId           String   @map("actor_id") @db.Uuid
  actorRoleAtAction String[] @map("actor_role_at_action")
  sessionId         String?  @map("session_id") @db.Uuid
  requestId         String?  @map("request_id")
  action            String   @db.VarChar(100)
  objectType        String   @map("object_type") @db.VarChar(50)
  objectId          String   @map("object_id") @db.Uuid
  beforeValue       Json?    @map("before_value")
  afterValue        Json?    @map("after_value")
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  prevHash          String?  @map("prev_hash")
  hash              String

  // onDelete/onUpdate are spelled out because Prisma's defaults are wrong here.
  // For an optional relation Prisma defaults to SetNull, which would emit
  // `ON DELETE SET NULL` on session_id -- and a referential action runs with the
  // TABLE OWNER's rights, not the caller's, so it sails straight past the
  // privilege revoke and slams into the append-only trigger instead. Deleting a
  // session would then fail at runtime, and the pressure to "fix" that lands on
  // the trigger, which is the one thing that must not move (ADR-04, K-7).
  actor   AppUser  @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([objectType, objectId, occurredAt], map: "idx_audit_log_object")
  @@index([actorId, occurredAt], map: "idx_audit_log_actor")
  @@index([sessionId], map: "idx_audit_log_session_id")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Authorization -- FR-X-005, FR-X-007 (columns not enumerated in the ERD;
// designed against FRD/API-CONTRACT, see packages/db/README.md)
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique(map: "uq_permission_code") @db.VarChar(100)
  name        String   @db.VarChar(200)
  description String?
  module      String?  @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String   @id @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([permissionId], map: "idx_role_permission_permission_id")
  @@map("role_permission")
}

model Delegation {
  id         String    @id @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime  @map("valid_until") @db.Date
  scope      String[]
  reason     String
  isActive   Boolean   @default(true) @map("is_active")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromUser AppUser @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toUser   AppUser @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([toUserId, isActive], map: "idx_delegation_to_user_active")
  @@index([fromUserId], map: "idx_delegation_from_user_id")
  @@map("delegation")
}

// ---------------------------------------------------------------------------
// Session -- FR-X-002 (not in ERD; persisted so idle/absolute timeout and
// remote termination can be enforced server-side, not via stateless JWT)
// ---------------------------------------------------------------------------

model Session {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  ipAddress         String    @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent")
  refreshTokenHash  String    @unique(map: "uq_session_refresh_token_hash") @map("refresh_token_hash") @db.VarChar(64)
  isActive          Boolean   @default(true) @map("is_active")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId   String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason      String?   @map("revoke_reason") @db.VarChar(40)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            AppUser    @relation("SessionUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedByUser   AppUser?   @relation("SessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auditLogEntries AuditLog[]

  // idx_session_idle_expires_at and idx_session_absolute_expires_at exist in
  // migration.sql as PARTIAL indexes (`WHERE is_active`). Prisma's schema
  // language cannot express a partial index, so they are deliberately left
  // undeclared here rather than declared as full (non-partial) indexes, which
  // would misrepresent what actually exists in the database. See
  // packages/db/README.md.
  @@index([userId, isActive], map: "idx_session_user_active")
  @@map("session")
}

// ---------------------------------------------------------------------------
// Uploaded file -- FR-X-013 (not in ERD; generic upload/scan tracking used
// later by Modul A evidence versions and Modul C document versions)
// ---------------------------------------------------------------------------

model UploadedFile {
  id                String         @id @db.Uuid
  uploadedByUserId  String         @map("uploaded_by_user_id") @db.Uuid
  originalFileName  String         @map("original_file_name")
  sanitizedFileName String         @map("sanitized_file_name")
  storageKey        String         @unique(map: "uq_uploaded_file_storage_key") @map("storage_key")
  fileSize          BigInt         @map("file_size")
  declaredMimeType  String?        @map("declared_mime_type") @db.VarChar(255)
  detectedMimeType  String?        @map("detected_mime_type") @db.VarChar(255)
  sha256            String         @db.VarChar(64)
  scanStatus        FileScanStatus @default(MENUNGGU_PEMINDAIAN) @map("scan_status")
  scanCompletedAt   DateTime?      @map("scan_completed_at") @db.Timestamptz(6)
  scanEngineVersion String?        @map("scan_engine_version") @db.VarChar(100)
  quarantinedAt     DateTime?      @map("quarantined_at") @db.Timestamptz(6)
  purpose           String         @db.VarChar(30)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy AppUser @relation(fields: [uploadedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sha256], map: "idx_uploaded_file_sha256")
  @@index([scanStatus], map: "idx_uploaded_file_scan_status")
  @@index([uploadedByUserId], map: "idx_uploaded_file_uploaded_by")
  @@map("uploaded_file")
}

// ---------------------------------------------------------------------------
// Notification -- FR-X-010, FR-X-011 (not in ERD)
// ---------------------------------------------------------------------------

model Notification {
  id              String    @id @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  code            String    @db.VarChar(10)
  title           String
  body            String?
  objectType      String?   @map("object_type") @db.VarChar(50)
  objectId        String?   @map("object_id") @db.Uuid
  canBeSummarized Boolean   @map("can_be_summarized")
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  emailStatus     String    @default("TIDAK_BERLAKU") @map("email_status") @db.VarChar(20)
  emailAttempts   Int       @default(0) @map("email_attempts") @db.SmallInt
  emailFailedAt   DateTime? @map("email_failed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient AppUser @relation(fields: [recipientUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([recipientUserId, isRead], map: "idx_notification_recipient_unread")
  @@index([code], map: "idx_notification_code")
  @@index([objectType, objectId], map: "idx_notification_object")
  @@map("notification")
}

model NotificationPreference {
  id                String                @id @db.Uuid
  userId            String                @unique(map: "uq_notification_preference_user_id") @map("user_id") @db.Uuid
  defaultFrequency  NotificationFrequency @default(SEKETIKA) @map("default_frequency")
  categoryOverrides Json                  @default("{}") @map("category_overrides")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notification_preference")
}

// ---------------------------------------------------------------------------
// Modul B -- Access Review (docs/04-TRD.md Sec 3.3, docs/03-FRD.md FR-B-001
// ..025, docs/10-TEST-PLAN.md Sec 3.2 critical controls K-1/K-2/K-3/K-4/K-9).
//
// KNOWN, DOCUMENTED GAPS BETWEEN THIS FILE AND migration.sql (see
// packages/db/README.md "Modul B" section for the full writeup):
//
//   1. CHECK constraints (K-1, K-2/K-3 reason rules, K-4 not-null-default,
//      every other chk_* in the migration) have no Prisma schema-language
//      equivalent at all and are simply absent here, same as every CHECK in
//      the foundation migration (chk_app_user_type_consistency etc.).
//   2. Partial indexes (`WHERE ...`) -- uq_campaign_signoff_active,
//      uq_sod_violation_open, uq_sod_exception_active,
//      idx_entitlement_catalog_uncategorized, idx_sod_rule_is_active -- are
//      deliberately left UNDECLARED, not declared as full (non-partial)
//      indexes, for the exact reason documented on the Session model above:
//      declaring them as full indexes would misrepresent what actually
//      exists in the database. Same precedent as
//      idx_session_idle_expires_at.
//   3. snapshot_line's RANGE partitioning (PARTITION BY / PARTITION OF) and
//      its two management functions have no Prisma schema-language
//      equivalent. The model below describes the logical (parent-table)
//      shape only; see the deviation note in migration.sql Sec 7 for why the
//      primary key is a composite (id, capturedAt) instead of id alone, and
//      why several other models below reference snapshotLineId as a plain
//      String with no Prisma @relation at all.
// ---------------------------------------------------------------------------

