{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/verify-docs/scripts/verify.py:*)",
      "Bash(python3 .claude/skills/run-eval/scripts/gate.py:*)",
      "Bash(node .claude/skills/verify-docs/scripts/check-mermaid.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx prisma migrate diff:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./eval/datasets/**)"
    ]
  }
}
