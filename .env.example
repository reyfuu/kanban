# Contoh konfigurasi SIGAP. Salin ke .env untuk pengembangan lokal.
#
# .env TIDAK PERNAH di-commit — lihat .gitignore.
#
# ADR-03 syarat G3: kredensial penyedia bahasa eksternal hanya hidup di
# penyimpanan rahasia. TIDAK di berkas ini, TIDAK di variabel lingkungan proses,
# TIDAK di citra kontainer. Berkas ini hanya memuat rujukan ke nama rahasianya.

# --- Basis data ---
POSTGRES_USER=sigap
POSTGRES_PASSWORD=sigap_dev_only
POSTGRES_DB=sigap
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sigap:sigap_dev_only@localhost:5433/sigap?schema=public

# Akun basis data yang dipakai aplikasi saat berjalan. ADR-04 menuntut akun ini
# TIDAK memiliki hak UPDATE maupun DELETE pada audit_log. Berbeda dari akun
# migrasi di atas, yang memang perlu hak DDL.
APP_DATABASE_URL=postgresql://sigap_app:CHANGE_ME@localhost:5433/sigap?schema=public

# Peran migrasi (ADR-04 / K-7). WAJIB berbeda dari APP_DATABASE_URL.
# Peran yang menjalankan migrasi memiliki objek yang dibuatnya, dan di
# PostgreSQL pemilik memegang seluruh grant option secara permanen. Menjalankan
# migrasi sebagai sigap_app membuatnya memiliki audit_log — dan pemilik dapat
# memberi hak kembali kepada dirinya sendiri, membuang pemicu, lalu mengosongkan
# tabel. Migrasi menyerahkan audit_log ke peran NOLOGIN di akhir, sehingga
# peran migrasi pun tidak menahannya.
MIGRATE_DATABASE_URL=postgresql://sigap_migrator:CHANGE_ME@localhost:5433/sigap?schema=public

# --- Antrean & cache ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Penyimpanan objek ---
MINIO_ROOT_USER=sigap
MINIO_ROOT_PASSWORD=sigap_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_EVIDENCE=sigap-evidence
MINIO_BUCKET_DOCUMENTS=sigap-documents
MINIO_BUCKET_EXPORTS=sigap-exports

# --- Pemindai berkas ---
CLAMAV_PORT=3310
CLAMAV_HOST=localhost

# --- Active Directory (ADR-06) ---
# LDAPS, bukan LDAP. FR-X-001: kegagalan koneksi berarti penolakan akses,
# bukan pelewatan pemeriksaan.
LDAP_URL=ldaps://dc.contoh.internal:636
LDAP_BIND_DN=CN=sigap-svc,OU=ServiceAccounts,DC=contoh,DC=internal
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_BASE_DN=DC=contoh,DC=internal
LDAP_TLS_CA_FILE=./secrets/ad-ca.pem

# --- Sesi (FR-X-002) ---
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_WARNING_BEFORE_MINUTES=2
# FR-X-003: autentikasi ulang berlaku maksimal 5 menit.
STEP_UP_AUTH_TTL_MINUTES=5

# --- Aplikasi ---
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
TZ=Asia/Jakarta

# --- LLM Gateway (ADR-03) ---
# Belum aktif. AG-1 dan AG-6 tidak boleh dinyalakan sebelum G1–G7 terpenuhi dan
# dibuktikan ke Divisi Kepatuhan. Nilai di bawah adalah NAMA RAHASIA yang dibaca
# gateway dari penyimpanan rahasia, bukan kuncinya.
LLM_GATEWAY_ENABLED=false
LLM_PROVIDER=gemini
LLM_SECRET_REF=sigap/llm/gemini-api-key
LLM_REGION_ENDPOINT=CHANGE_ME
LLM_MONTHLY_BUDGET_IDR=0
