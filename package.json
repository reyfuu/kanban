{
  "name": "sigap",
  "version": "0.1.0",
  "private": true,
  "description": "SIGAP — Sistem Integrasi Governance, Akses, dan Prosedur",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @sigap/api start:dev",
    "dev:worker": "pnpm --filter @sigap/api start:worker",
    "dev:web": "pnpm --filter @sigap/web dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @sigap/db generate",
    "db:migrate": "pnpm --filter @sigap/db migrate:dev",
    "verify:docs": "python3 .claude/skills/verify-docs/scripts/verify.py docs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
