{
  "name": "hoyokanban",
  "version": "1.0.0",
  "private": true,
  "description": "HoyoKanban \u2014 Genshin Impact & ZZZ Character Build Tracker",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @hoyokanban/web dev",
    "build": "pnpm --filter @hoyokanban/web build",
    "start": "pnpm --filter @hoyokanban/web start",
    "typecheck": "pnpm --filter @hoyokanban/web exec tsc --noEmit",
    "test": "pnpm --filter @hoyokanban/web test",
    "sync:catalog": "python3 scripts/sync-catalog.py"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
